TZ=America/New_York
APP_PORT=5010
CONTAINER_NAME=selfhosted-catalog
MEMORY_LIMIT=384m
CPU_LIMIT=0.5
RESTART_POLICY=unless-stopped
LOG_LEVEL=INFO

# Optional. Without a token GitHub allows 60 requests an hour, so the first
# backfill pauses and resumes. Paste the output of: gh auth token
GITHUB_TOKEN=

# Monday 08:00 in TZ. The newest Reddit thread is left open.
PULL_WEEKDAY=0
PULL_HOUR=8
PULL_MINUTE=0
# Daily pass over release posts still up on the main page.
FEED_HOUR=7
FEED_MINUTE=0
RUN_ON_START=1

ARCTIC_SHIFT_BASE=https://arctic-shift.photon-reddit.com
REQUEST_GAP_S=1.2
USER_AGENT=selfhosted-catalog/1.0 (self-hosted; weekly r/selfhosted catalog)
